]
}

[internationalization]

locale/translation_remaps={
"res://data/fonts/07にくまるフォント.otf": PackedStringArray("res://data/fonts/07にくまるフォント.otf:en", "res://data/fonts/Hakgyoansim Dunggeunmiso TTF B.ttf:ko", "res://data/fonts/ZhanKuKuaiLeTi2016XiuDingBan-1.ttf:zh"),
"res://data/fonts/Petanko-Bold.otf": PackedStringArray("res://data/fonts/Petanko-Bold.otf:en", "res://data/fonts/경기천년제목_Bold.ttf:ko", "res://data/fonts/SweiFistLegCJKsc-Bold-2.ttf:zh"),
"res://data/fonts/Petanko-Regular.otf": PackedStringArray("res://data/fonts/경기천년제목_Light.ttf:ko", "res://data/fonts/Petanko-Regular.otf:en", "res://data/fonts/SweiFistLegCJKsc-Regular-2.ttf:zh"),
"res://data/images/cutscene/e8_sign_jp.webp": PackedStringArray("res://data/images/cutscene/e8_sign_en.webp:en", "res://data/images/cutscene/e8_sign_ko.webp:ko", "res://data/images/cutscene/e8_sign_jp.webp:zh"),
"res://data/images/cutscene_censored/e8_sign_jp.webp": PackedStringArray("res://data/images/cutscene_censored/e8_sign_en.webp:en", "res://data/images/cutscene_censored/e8_sign_jp.webp:zh", "res://data/images/cutscene_censored/e8_sign_ko.webp:ko"),
"res://data/images/ui/next_char_name_jp.webp": PackedStringArray("res://data/images/ui/next_char_name_en.webp:en", "res://data/images/ui/next_char_name_ko.webp:ko", "res://data/images/ui/next_char_name_en.webp:zh"),
"res://data/images/ui/title_demo_ja.webp": PackedStringArray("res://data/images/ui/title_demo_en.webp:en", "res://data/images/ui/title_demo_ko.webp:ko", "res://data/images/ui/title_demo_zh.webp:zh"),
"res://data/images/ui/title_ja.webp": PackedStringArray("res://data/images/ui/title_en.webp:en", "res://data/images/ui/title_ko.webp:ko", "res://data/images/ui/title_zh.webp:zh")
}
locale/translations=PackedStringArray("res://data/texts/general.en.translation", "res://data/texts/general.ja.translation", "res://data/texts/general.ko.translation", "res://data/texts/general.zh.translation", "res://data/texts/dialogue.en.translation", "res://data/texts/dialogue.ja.translation", "res://data/texts/dialogue.ko.translation", "res://data/texts/dialogue.zh.translation")
locale/test="ja"
locale/fallback="ja"
locale/language_filter=["en", "ja", "ko", "zh"]
locale/locale_filter_mode=1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=2
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
